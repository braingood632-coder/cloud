# انسخ هذا الملف إلى functions/.env وعبّئه (إعدادات عادية غير سرية — تُرفع مع الدوال)
# المفاتيح السرية لا توضع هنا، بل بالأمر: firebase functions:secrets:set BOT_TOKEN

BOT_NAME=Cloud
# اسم مستخدم البوت بدون @ (اختياري: يُجلب تلقائياً من تليجرام)
BOT_USERNAME=
# معرفك الرقمي في تليجرام (من @userinfobot) — مستثنى دائماً من الحذف
OWNER_TELEGRAM_ID=0
SUPPORT_USERNAME=radhadh91
# نسبة عمولتك من كل اشتراك (0 = كامل المبلغ لصاحب القروب)
PLATFORM_COMMISSION_PERCENT=0
# إيميلك في الموقع — يحصل على لوحة الأدمن بعد تأكيد الإيميل
ADMIN_EMAILS=you@example.com
# 0 = توفير، 1 = استجابة فورية دائماً للبوت (تكلفة شهرية بسيطة)
MIN_INSTANCES=0
# اتركه فارغاً لاستخدام https://<project>.web.app ، أو ضع نطاقك الخاص إن ربطته
PUBLIC_BASE_URL=
