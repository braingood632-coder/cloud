rules_version = '2';

// قواعد حماية قاعدة البيانات:
// - كل صاحب قروب يرى بياناته فقط (قروباته، مشتركيه، تحويلاته).
// - الاشتراكات لا يكتبها إلا السيرفر (Admin SDK يتجاوز هذه القواعد).
// - الأدمن (role == 'admin') يرى كل شيء ويسجّل التحويلات.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/owners/$(request.auth.uid))
        && get(/databases/$(database)/documents/owners/$(request.auth.uid)).data.role == 'admin';
    }

    // أسعار القروب المخصصة: {plan_3m: رقم, plan_6m: رقم} (اختيارية)
    function validPrice(p, key) {
      return !(key in p) || (p[key] is number && p[key] >= 1 && p[key] <= 10000);
    }
    function validPrices(p) {
      return p is map && p.keys().hasOnly(['plan_3m', 'plan_6m'])
        && validPrice(p, 'plan_3m') && validPrice(p, 'plan_6m');
    }

    function profileFields() {
      return ['name', 'phone', 'telegramUsername', 'bankName', 'iban', 'accountHolder', 'updatedAt'];
    }

    function validProfile(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 20))
        && (!('telegramUsername' in d) || (d.telegramUsername is string && d.telegramUsername.size() <= 40))
        && (!('bankName' in d) || (d.bankName is string && d.bankName.size() <= 60))
        && (!('iban' in d) || (d.iban is string && d.iban.size() <= 34))
        && (!('accountHolder' in d) || (d.accountHolder is string && d.accountHolder.size() <= 80));
    }

    match /owners/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // الحسابات ينشئها الأدمن فقط عبر السيرفر (Admin SDK)؛ التسجيل العام مغلق
      allow create: if false;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields())
        && validProfile(request.resource.data);
      allow delete: if false;
    }

    // ربط القروبات للأدمن فقط: يولّد الكود لحساب صاحب القروب الذي يختاره
    match /linkCodes/{code} {
      allow create: if isAdmin()
        && code.matches('^[A-Z0-9]{8}$')
        && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt', 'prices'])
        && (!('prices' in request.resource.data) || validPrices(request.resource.data.prices))
        && request.resource.data.ownerUid is string
        && exists(/databases/$(database)/documents/owners/$(request.resource.data.ownerUid))
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      // صاحب القروب يشاهد فقط؛ الأدمن وحده يشغّل/يوقف التذكير أو يفك الربط
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remindersEnabled', 'prices'])
        && (!('remindersEnabled' in request.resource.data) || request.resource.data.remindersEnabled is bool)
        && (!('prices' in request.resource.data) || validPrices(request.resource.data.prices));
      allow delete: if isAdmin();
      allow create: if false;
    }

    match /subscriptions/{subId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /payouts/{payoutId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['ownerUid', 'amount', 'note', 'reference', 'createdAt', 'createdBy'])
        && request.resource.data.ownerUid is string
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
