# ===== تليجرام =====
BOT_TOKEN=
BOT_NAME=Cloud
# معرفك الرقمي في تليجرام (من @userinfobot) — مستثنى دائماً من الحذف
OWNER_TELEGRAM_ID=
SUPPORT_USERNAME=radhadh91

# ===== ميسر =====
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# ===== المنصة =====
# نسبة عمولتك من كل اشتراك (0 = كامل المبلغ لصاحب القروب)
PLATFORM_COMMISSION_PERCENT=0
# إيميلك الذي ستسجل به في الموقع — يحصل تلقائياً على لوحة الأدمن
ADMIN_EMAILS=you@example.com

# ===== Firebase (السيرفر) — سري =====
# الصق محتوى ملف service account كاملاً في سطر واحد، أو مسار الملف
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# ===== Firebase (الموقع) — عام وليس سرياً =====
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# ===== السيرفر =====
# رابط الموقع العام (مثل https://cloud-bot.onrender.com) بدون / في النهاية
PUBLIC_BASE_URL=
